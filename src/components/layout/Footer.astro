---
import { site, social } from "../../data/site";
import SocialLinks from "../ui/SocialLinks.astro";

interface Props {
	brand?: string;
	note?: string;
}

const {
	brand = site.brandMark,
	note = "IT professional expanding into software development.",
} = Astro.props;

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-border bg-surface-elevated/60">
	<div
		class="mx-auto flex max-w-6xl flex-col gap-6 px-5 py-10 sm:flex-row sm:items-end sm:justify-between sm:px-8"
	>
		<div>
			<p class="font-display text-lg font-bold tracking-[0.12em] text-ink">{brand}</p>
			<p class="mt-2 max-w-sm text-sm text-ink-muted">{note}</p>
			<p class="mt-3 text-sm text-ink-muted">
				Career history on
				<a
					href={social.linkedin.href}
					class="font-medium text-accent underline-offset-4 hover:underline"
					target="_blank"
					rel="noopener noreferrer"
				>
					LinkedIn
				</a>
			</p>
		</div>

		<div class="flex flex-col items-start gap-4 sm:items-end">
			<SocialLinks />
			<p class="text-sm text-ink-muted">
				<span aria-hidden="true">&copy;</span>
				<span class="sr-only">Copyright</span>
				{year} {site.fullName}
			</p>
		</div>
	</div>
</footer>
