---
import type { ProjectImages, ProjectPreview as PreviewKind } from "../../data/projects";

interface Props {
	kind: PreviewKind;
	title: string;
	images?: ProjectImages;
}

const { kind, title, images } = Astro.props;
---

{
	images ? (
		<figure class="project-preview project-preview--screens relative">
			<div class="overflow-hidden rounded-xl border border-border bg-surface-muted">
				<img
					src={images.desktop}
					alt={images.desktopAlt}
					width={images.desktopWidth}
					height={images.desktopHeight}
					class="block h-auto w-full"
					loading="lazy"
					decoding="async"
				/>
			</div>

			{images.mobile && (
				<div class="pointer-events-none absolute bottom-3 right-3 h-[78%] max-h-[22rem] sm:bottom-4 sm:right-4">
					<img
						src={images.mobile}
						alt={images.mobileAlt ?? `${title} mobile interface`}
						width={images.mobileWidth}
						height={images.mobileHeight}
						class="block h-full w-auto rounded-lg border border-border bg-surface-elevated shadow-[0_12px_28px_-12px_color-mix(in_srgb,var(--ink)_45%,transparent)]"
						loading="lazy"
						decoding="async"
					/>
				</div>
			)}
		</figure>
	) : (
		<div
			class="project-preview relative aspect-[16/10] overflow-hidden rounded-xl border border-border bg-surface-muted"
			aria-hidden="true"
			data-preview={kind}
		>
			<svg class="absolute inset-0 size-full" viewBox="0 0 640 400" role="img">
				<title>{title} preview</title>
				<defs>
					<linearGradient id={`g-${kind}`} x1="0%" y1="0%" x2="100%" y2="100%">
						<stop offset="0%" stop-color="currentColor" stop-opacity="0.12" />
						<stop offset="100%" stop-color="currentColor" stop-opacity="0.04" />
					</linearGradient>
				</defs>
				<rect width="640" height="400" fill={`url(#g-${kind})`} />

				{kind === "lab" && (
					<>
						<rect x="48" y="56" width="180" height="288" rx="16" fill="currentColor" opacity="0.08" />
						<rect x="72" y="88" width="132" height="14" rx="7" fill="currentColor" opacity="0.28" />
						<rect x="72" y="120" width="96" height="10" rx="5" fill="currentColor" opacity="0.16" />
						<rect x="72" y="148" width="112" height="10" rx="5" fill="currentColor" opacity="0.16" />
						<rect x="72" y="176" width="84" height="10" rx="5" fill="currentColor" opacity="0.16" />
						<rect x="256" y="56" width="336" height="288" rx="16" fill="currentColor" opacity="0.06" />
						<circle cx="304" cy="112" r="18" fill="currentColor" opacity="0.22" />
						<rect x="340" y="102" width="180" height="12" rx="6" fill="currentColor" opacity="0.22" />
						<rect x="340" y="128" width="140" height="10" rx="5" fill="currentColor" opacity="0.12" />
						<rect x="288" y="176" width="272" height="120" rx="12" fill="currentColor" opacity="0.1" />
						<path
							d="M320 236h80M320 260h140M320 284h108"
							stroke="currentColor"
							stroke-width="8"
							stroke-linecap="round"
							opacity="0.2"
						/>
					</>
				)}

				{kind === "cart" && (
					<>
						<rect x="64" y="72" width="220" height="256" rx="18" fill="currentColor" opacity="0.08" />
						<rect x="92" y="104" width="164" height="96" rx="12" fill="currentColor" opacity="0.14" />
						<rect x="92" y="220" width="110" height="12" rx="6" fill="currentColor" opacity="0.22" />
						<rect x="92" y="248" width="72" height="10" rx="5" fill="currentColor" opacity="0.14" />
						<rect x="320" y="72" width="256" height="256" rx="18" fill="currentColor" opacity="0.06" />
						<rect x="348" y="108" width="200" height="18" rx="9" fill="currentColor" opacity="0.22" />
						{[0, 1, 2].map((i) => (
							<g transform={`translate(348 ${160 + i * 48})`}>
								<rect width="40" height="32" rx="8" fill="currentColor" opacity="0.16" />
								<rect x="56" y="4" width="120" height="10" rx="5" fill="currentColor" opacity="0.2" />
								<rect x="56" y="20" width="64" height="8" rx="4" fill="currentColor" opacity="0.12" />
							</g>
						))}
					</>
				)}

				{kind === "profile" && (
					<>
						<rect x="170" y="48" width="300" height="304" rx="24" fill="currentColor" opacity="0.07" />
						<circle cx="320" cy="140" r="42" fill="currentColor" opacity="0.18" />
						<rect x="230" y="206" width="180" height="16" rx="8" fill="currentColor" opacity="0.24" />
						<rect x="250" y="236" width="140" height="10" rx="5" fill="currentColor" opacity="0.14" />
						<rect x="210" y="272" width="220" height="40" rx="12" fill="currentColor" opacity="0.1" />
					</>
				)}

				{kind === "chain" && (
					<>
						<rect x="72" y="80" width="496" height="240" rx="20" fill="currentColor" opacity="0.06" />
						{[0, 1, 2, 3].map((i) => (
							<g transform={`translate(${120 + i * 110} 150)`}>
								<rect width="72" height="100" rx="14" fill="currentColor" opacity="0.12" />
								<circle cx="36" cy="36" r="14" fill="currentColor" opacity="0.22" />
								<rect x="16" y="64" width="40" height="8" rx="4" fill="currentColor" opacity="0.18" />
								{i < 3 && (
									<path
										d="M78 50h26"
										stroke="currentColor"
										stroke-width="6"
										stroke-linecap="round"
										opacity="0.2"
									/>
								)}
							</g>
						))}
					</>
				)}
			</svg>
		</div>
	)
}

<style>
	.project-preview:not(.project-preview--screens) {
		color: var(--accent);
	}
</style>
