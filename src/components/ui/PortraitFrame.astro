---
import { site } from "../../data/site";

interface Props {
	class?: string;
}

const { class: className = "" } = Astro.props;
const initials = "BK";
---

<figure
	class:list={[
		"portrait-frame relative overflow-hidden rounded-[1.5rem] border border-accent/25 bg-surface-elevated shadow-[inset_0_1px_0_color-mix(in_srgb,var(--ink)_8%,transparent)]",
		className,
	]}
	aria-label={`Portrait placeholder for ${site.fullName}`}
>
	<div class="absolute inset-0 portrait-mesh" aria-hidden="true"></div>
	<div class="absolute -right-8 top-10 size-40 rounded-full border border-accent/40" aria-hidden="true"></div>
	<div class="absolute -left-10 bottom-8 size-32 rotate-12 rounded-3xl bg-accent/20" aria-hidden="true"></div>
	<div
		class="absolute inset-x-8 top-8 h-px bg-gradient-to-r from-transparent via-accent/60 to-transparent"
		aria-hidden="true"
	>
	</div>

	<div class="relative flex aspect-[4/5] flex-col items-center justify-center gap-5 px-6 py-10 text-center sm:aspect-[5/6] nest-hub:aspect-[5/5] nest-hub:gap-4 nest-hub:py-8">
		<div
			class="flex size-28 items-center justify-center rounded-full border border-accent/45 bg-accent-soft font-display text-3xl font-bold tracking-[0.08em] text-accent sm:size-32 sm:text-4xl nest-hub:size-24 nest-hub:text-3xl"
			aria-hidden="true"
		>
			{initials}
		</div>
		<figcaption class="max-w-[14rem]">
			<p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-ink">
				{site.brandMark}
			</p>
			<p class="mt-2 text-sm leading-relaxed text-ink-muted">
				Portrait space reserved — a professional photograph will land here.
			</p>
		</figcaption>
	</div>
</figure>
