---
import { capabilityGroups } from "../../data/capabilities";
import SectionHeading from "../ui/SectionHeading.astro";
---

<section
	id="capabilities"
	class="section-shell border-b border-border"
	aria-labelledby="capabilities-heading"
>
	<div class="mx-auto max-w-6xl px-5 sm:px-8">
		<SectionHeading
			id="capabilities-heading"
			eyebrow="Capabilities"
			title="Skills shaped by practice — and honest about what’s still growing."
			description="Grouped by how I actually work. Practiced means I’ve used it in real situations; learning marks areas I’m actively developing."
			align="split"
		/>

		<div class="mt-6 flex flex-wrap gap-3 text-xs font-semibold uppercase tracking-[0.16em]">
			<span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface-elevated px-3 py-1.5 text-ink">
				<span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
				Practiced
			</span>
			<span class="inline-flex items-center gap-2 rounded-full border border-dashed border-border bg-transparent px-3 py-1.5 text-ink-muted">
				<span class="size-2 rounded-full bg-ink-muted/50" aria-hidden="true"></span>
				Currently learning
			</span>
		</div>

		<div class="mt-12 grid gap-px overflow-hidden rounded-[1.25rem] border border-border bg-border sm:grid-cols-2">
			{
				capabilityGroups.map((group, index) => (
					<article
						class:list={[
							"reveal group bg-surface-elevated p-6 sm:p-8",
							index === 0 && "sm:col-span-2 lg:grid lg:grid-cols-[0.9fr_1.1fr] lg:gap-10",
						]}
						style={`--reveal-delay: ${index * 60}ms`}
					>
						<div>
							<p class="font-display text-xs font-semibold uppercase tracking-[0.2em] text-accent">
								{String(index + 1).padStart(2, "0")}
							</p>
							<h3 class="mt-3 font-display text-2xl font-bold tracking-tight text-ink">
								{group.title}
							</h3>
							<p class="mt-3 max-w-md text-sm leading-relaxed text-ink-muted sm:text-base">
								{group.summary}
							</p>
						</div>

						<ul class="mt-6 space-y-3 lg:mt-0 lg:self-end">
							{group.items.map((item) => (
								<li class="flex items-start justify-between gap-4 border-b border-border/70 pb-3 last:border-0 last:pb-0">
									<span class="text-sm font-medium text-ink sm:text-base">{item.label}</span>
									<span
										class:list={[
											"shrink-0 rounded-full px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.14em]",
											item.level === "practiced"
												? "bg-accent-soft text-accent"
												: "border border-dashed border-border text-ink-muted",
										]}
									>
										{item.level === "practiced" ? "Practiced" : "Learning"}
									</span>
								</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
	</div>
</section>
