---
import { site } from "../../data/site";
import Icons from "../ui/Icons.astro";
import PortraitFrame from "../ui/PortraitFrame.astro";
import SocialLinks from "../ui/SocialLinks.astro";
---

<section
	class="hero relative overflow-hidden border-b border-border"
	aria-labelledby="hero-heading"
>
	<div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>

	<div
		class="relative mx-auto grid max-w-6xl gap-10 px-5 py-12 sm:px-8 sm:py-14 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:items-center lg:gap-12 lg:py-16 xl:gap-16 xl:py-20 nest-hub:gap-8 nest-hub:py-10"
	>
		<div class="reveal min-w-0">
			<p class="font-display text-xs font-semibold uppercase tracking-[0.28em] text-accent sm:text-sm">
				{site.brandMark}
			</p>

			<h1
				id="hero-heading"
				class="mt-4 font-display text-[clamp(2.35rem,6.2vw,4.75rem)] font-bold leading-[0.95] tracking-tight text-ink nest-hub:text-[clamp(2.4rem,4.2vw,3.6rem)]"
			>
				<span class="block">Brandon</span>
				<span class="block">Kibochi</span>
				<span class="block text-accent">Njenga</span>
			</h1>

			<p class="mt-5 max-w-xl font-display text-sm font-semibold leading-snug tracking-wide text-ink sm:text-base lg:text-lg">
				{site.positioning}
			</p>

			<p class="mt-5 max-w-xl text-base leading-relaxed text-ink-muted sm:text-lg nest-hub:mt-4 nest-hub:text-base">
				I bring a practical foundation in IT operations — troubleshooting systems, supporting people,
				and keeping technology reliable — while expanding into software development. I enjoy learning
				by building useful solutions and making complex problems feel manageable.
			</p>

			<div class="mt-8 flex flex-wrap items-center gap-3 nest-hub:mt-6">
				<a
					href="#projects"
					class="inline-flex items-center gap-2 rounded-md bg-accent px-5 py-3 text-sm font-semibold text-white transition hover:opacity-90"
				>
					View my work
					<Icons name="arrow" class="size-4" />
				</a>
				<a
					href="#contact"
					class="inline-flex items-center gap-2 rounded-md border border-border bg-surface-elevated/80 px-5 py-3 text-sm font-semibold text-ink transition-colors hover:bg-surface-muted"
				>
					Get in touch
				</a>
			</div>

			<div class="mt-8 flex flex-wrap items-center gap-4 nest-hub:mt-6">
				<p class="text-xs font-semibold uppercase tracking-[0.18em] text-ink-muted">Find me</p>
				<SocialLinks />
			</div>
		</div>

		<div class="reveal reveal-delay-2 relative mx-auto w-full max-w-md lg:mx-0 lg:max-w-none">
			<div
				class="pointer-events-none absolute -inset-4 -z-10 rounded-[2rem] bg-accent/10 blur-2xl nest-hub:-inset-2"
				aria-hidden="true"
			>
			</div>
			<PortraitFrame class="shadow-[0_24px_80px_-40px_color-mix(in_srgb,var(--accent)_55%,transparent)]" />
			<p
				class="mt-4 text-center font-display text-[0.7rem] font-semibold uppercase tracking-[0.24em] text-ink-muted lg:text-left"
			>
				Visual identity in progress
			</p>
		</div>
	</div>
</section>
