---
import { projects } from "../../data/projects";
import Icons from "../ui/Icons.astro";
import ProjectPreview from "../ui/ProjectPreview.astro";
import SectionHeading from "../ui/SectionHeading.astro";
---

<section id="projects" class="section-shell border-b border-border" aria-labelledby="projects-heading">
	<div class="mx-auto max-w-6xl px-5 sm:px-8">
		<SectionHeading
			id="projects-heading"
			eyebrow="Selected projects"
			title="Work that shows how I learn — by building."
			description="Featured builds, learning experiments and earlier studies. Live demos and source links appear only when they are publicly available."
			align="split"
		/>

		<div class="mt-12 space-y-8 lg:space-y-10">
			{
				projects.map((project, index) => (
					<article
						class:list={[
							"reveal project-entry group grid gap-6 overflow-hidden rounded-[1.35rem] border border-border bg-surface-elevated/80 p-4 sm:p-6",
							project.featured
								? "lg:grid-cols-[1.15fr_0.85fr] lg:items-center"
								: index % 2 === 1
									? "md:grid-cols-[0.95fr_1.05fr] md:items-center"
									: "md:grid-cols-[1.05fr_0.95fr] md:items-center",
						]}
						style={`--reveal-delay: ${index * 70}ms`}
					>
						<div class:list={[!project.featured && index % 2 === 1 && "md:order-2"]}>
							<ProjectPreview
								kind={project.preview}
								title={project.title}
								images={project.images}
							/>
						</div>

						<div class:list={["flex min-w-0 flex-col", !project.featured && index % 2 === 1 && "md:order-1"]}>
							<div class="flex flex-wrap items-center gap-3">
								<span
									class:list={[
										"rounded-full px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.14em]",
										project.status === "legacy"
											? "border border-border text-ink-muted"
											: project.status === "learning"
												? "border border-dashed border-accent/50 text-accent"
												: "bg-accent-soft text-accent",
									]}
								>
									{project.statusLabel}
								</span>
								{project.featured && (
									<span class="text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-ink-muted">
										Featured
									</span>
								)}
							</div>

							<h3 class="mt-4 font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
								{project.title}
							</h3>
							<p class="mt-3 text-sm leading-relaxed text-ink-muted sm:text-base">
								{project.description}
							</p>

							{project.features && project.features.length > 0 && (
								<ul
									class="mt-5 space-y-2 border-t border-border/70 pt-5"
									aria-label={`Highlights for ${project.title}`}
								>
									{project.features.map((feature) => (
										<li class="flex gap-2.5 text-sm leading-snug text-ink-muted">
											<span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
											<span>{feature}</span>
										</li>
									))}
								</ul>
							)}

							<ul class="mt-5 flex flex-wrap gap-2" aria-label={`Technologies for ${project.title}`}>
								{project.technologies.map((tech) => (
									<li class="rounded-md border border-border bg-surface px-2.5 py-1 text-xs font-medium text-ink-muted">
										{tech}
									</li>
								))}
							</ul>

							{(project.githubUrl || project.liveUrl) && (
								<div class="mt-6 flex flex-wrap gap-x-5 gap-y-3">
									{project.liveUrl && (
										<a
											href={project.liveUrl}
											class="inline-flex items-center gap-2 text-sm font-semibold text-accent underline-offset-4 hover:underline"
											target="_blank"
											rel="noopener noreferrer"
										>
											<Icons name="external" class="size-4" />
											Live Demo
										</a>
									)}
									{project.githubUrl && (
										<a
											href={project.githubUrl}
											class="inline-flex items-center gap-2 text-sm font-semibold text-ink underline-offset-4 hover:underline"
											target="_blank"
											rel="noopener noreferrer"
										>
											<Icons name="github" class="size-4" />
											View Source Code
										</a>
									)}
								</div>
							)}

							{!project.githubUrl && !project.liveUrl && (
								<p class="mt-6 text-xs text-ink-muted">
									Public repository and live demo links will be added when available.
								</p>
							)}
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
